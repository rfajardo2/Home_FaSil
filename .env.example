# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings → API). Vars prefixed EXPO_PUBLIC_ are safe to expose to
# the client — that's the anon key, not the service_role key. Never put the
# service_role key here.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
